{
  "name": "fittrack-gym-management",
  "version": "2.4.0",
  "description": "FitTrack — Cloud-Based Fitness and Gym Management System with Express.js, MySQL, and Vanilla Frontend",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "db:setup": "node backend/scripts/setupDb.js",
    "init-admin": "node backend/scripts/initAdmin.js",
    "migrate:inr": "node backend/scripts/migrateINR.js",
    "build:zip": "node backend/scripts/packageDeploy.js",
    "test": "jest --runInBand --forceExit"
  },
  "keywords": [
    "gym-management",
    "fitness",
    "turnstile",
    "express",
    "mysql",
    "vanilla-js"
  ],
  "author": "FitTrack Core Team",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/backend/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/_backup.*/"
    ],
    "verbose": true
  }
}
