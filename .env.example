# ==============================================================================
# FitTrack Gym Management System — Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual settings.
# ==============================================================================

# Server Network Settings
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fittrack_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
COOKIE_SECURE=false

# CORS (Frontend Domain or Origin)
CLIENT_ORIGIN=http://localhost:3000
